# Local environment and secrets; keep shareable configuration templates.
.env
.env.*
!.env.example
!.env.*.example

# Local databases, credentials, runtime state, backups and source snapshots.
/.local/
/data/raw/
/data/normalized/
/data/index/

# Java / Maven build output.
/backend/target/
*.class

# Frontend dependencies, builds, caches and generated TypeScript metadata.
node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.vite-temp/
/frontend/.cache/
*.tsbuildinfo

# Automated test output and coverage reports.
/frontend/playwright-report/
/frontend/test-results/
/frontend/blob-report/
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*

# Python helpers: bytecode, virtual environments and tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs, process IDs and temporary files.
*.log
*.pid
*.pid.lock
*.tmp
*.temp
*.swp
*.swo
*~

# IDE-specific local settings.
.idea/
.vscode/
*.iml

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Disposable local plans and dated prompts; canonical docs remain versioned.
/plans/
/修改计划*.md
/[0-9]*.[0-9]*.txt

# Runtime evidence stays local; retain the fixed public test/experiment inputs.
/data/samples/*
!/data/samples/identity-title-candidates-2026-10-22.json
!/data/samples/10.21-portrait-head-audit.json
!/data/samples/external-coverage-baseline-2026-10-22.json
!/data/samples/moegirl-info-2026-10-22.json
!/data/samples/moegirl-rights-2026-10-22.json
!/data/samples/10.21-recommendation-evaluation.json
!/data/samples/reviewed-evidence-example.json

# Local AI tooling; not part of the application source.
/.agents/
/.codex/
/skills-lock.json
