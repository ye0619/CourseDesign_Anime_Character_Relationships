# Copy with scripts/Initialize-Local.ps1 to generate local secrets.
MYSQL_DATABASE=animegraph
MYSQL_USER=animegraph
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# The normal product has no local login. Enable only for legacy maintenance scripts.
LEGACY_ADMIN_ENABLED=false
# Set to your own Bangumi developer ID/application/version before distributing.
BANGUMI_USER_AGENT=AnimeGraphGraduation/local-viewer/0.6
# Optional HTTP proxy URL. Windows launcher also honors the current system proxy.
BANGUMI_PROXY=
# Defaults for public read-only sources. Override only for a trusted local test server.
BANGUMI_API_BASE=https://api.bgm.tv
BANGUMI_NETWORK_BASE=https://next.bgm.tv
# Optional absolute path. Only this project's process uses this JDK.
JAVA_HOME=

# Official Archive index; resolved relative to backend/ by the launcher.
BANGUMI_ARCHIVE_INDEX=../data/index/bangumi
