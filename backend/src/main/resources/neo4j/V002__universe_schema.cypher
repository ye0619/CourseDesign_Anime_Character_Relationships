CREATE CONSTRAINT universe_uid IF NOT EXISTS FOR (n:Universe) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT series_uid IF NOT EXISTS FOR (n:Series) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT assertion_uid IF NOT EXISTS FOR (n:RelationAssertion) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT evidence_uid IF NOT EXISTS FOR (n:Evidence) REQUIRE n.uid IS UNIQUE;
